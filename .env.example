# Copy this file to .env and check each model id against LM Studio.
#
# Setup used for the capstone results (all local, MacBook Pro M4 Pro, 48 GB):
# in LM Studio (Developer tab) start the server and load all three models at the same time,
# then copy each model id exactly as LM Studio shows it.
#   - Qwen3.6-35B-A3B (MLX 4-bit), context 32768: every agent except the Critic
#   - Gemma 3 12B, context 16384: the Critic (a different model family from the writer)
#   - nomic-embed-text v1.5, context 2048: embeddings for RAG
# Check the setup with:  python scripts/model_check.py

# All agents except the Critic
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen3.6-35b-a3b-mlx
LLM_API_KEY=lm-studio

# Critic: keep it on a different model family than LLM_MODEL so it does not approve its own
# family's reasoning. The run flags it if both use the same model.
LLM_CRITIC_BASE_URL=http://localhost:1234/v1
LLM_CRITIC_MODEL=google/gemma-3-12b
LLM_CRITIC_API_KEY=lm-studio

# Embeddings for RAG: nomic-embed-text in LM Studio. Empty = keyword search (BM25) only.
LLM_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
# LLM_EMBED_BASE_URL defaults to LLM_BASE_URL
# Knowledge base folder (default kb_sources; KB_DIR=kb for the old placeholder notes)

# Optional per-agent overrides. Agent names: discovery_profile, discovery_research,
# process_mapper, matcher, strategist, critic, planner. Each agent can have its own
# LLM_<AGENT>_MODEL, LLM_<AGENT>_BASE_URL, LLM_<AGENT>_API_KEY and LLM_<AGENT>_TIMEOUT.
# Example: a longer timeout for the Process Mapper on a slower machine:
# LLM_PROCESS_MAPPER_TIMEOUT=1200
#
# Smaller machine: a 7-8B model for all agents (faster, but it grounds its answers less well;
# keep the Critic on a different family).
# LLM_MODEL=qwen2.5-7b-instruct

# Hosted models (for example OpenRouter) are refused unless the agent is listed in
# LLM_ALLOW_HOSTED, so private company data is never sent by accident.
# Example: a hosted model for the matcher only:
# LLM_MATCHER_BASE_URL=https://openrouter.ai/api/v1
# LLM_MATCHER_MODEL=<model id from OpenRouter>
# LLM_MATCHER_API_KEY=your-openrouter-key
# LLM_ALLOW_HOSTED=matcher
