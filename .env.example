# Local LM Studio (default): load the model, start the server in the Developer tab,
# and copy the exact model id it shows.
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen2.5-7b-instruct
LLM_API_KEY=lm-studio

# OpenRouter instead (uncomment and fill in):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_API_KEY=your-key-here

# Per-agent overrides. Agent names: discovery_profile, discovery_research, process_mapper,
# matcher, strategist, critic, planner. Example: a different local model for the critic:
# LLM_CRITIC_MODEL=llama-3.1-8b-instruct
#
# Example: Claude (via OpenRouter) for the matcher only. Hosted models are refused unless the
# agent is listed in LLM_ALLOW_HOSTED, so private data is never sent by accident.
# LLM_MATCHER_BASE_URL=https://openrouter.ai/api/v1
# LLM_MATCHER_MODEL=<a Claude model id from OpenRouter>
# LLM_MATCHER_API_KEY=your-openrouter-key
# LLM_ALLOW_HOSTED=matcher

# Recommended split (Nov 14): everything on the big model, the Critic on a different one so it
# does not approve its own family's reasoning. The run flags it if both use the same model.
# LLM_CRITIC_BASE_URL=http://localhost:1234/v1
# LLM_CRITIC_MODEL=qwen2.5-7b-instruct
# LLM_CRITIC_API_KEY=lm-studio
