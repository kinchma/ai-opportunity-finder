# Mac-only setup: every agent uses LM Studio on this Mac (localhost), so no network is needed.
# On the Mac:  cp .env.mac .env   then check the two model ids below against LM Studio.
#
# In LM Studio (Developer tab): start the server and load BOTH models at the same time.
# Copy each model id exactly as LM Studio shows it.

# All agents except the Critic: Qwen3.6-35B-A3B (MLX, 4-bit)
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen3.6-35b-a3b-mlx
LLM_API_KEY=lm-studio

# Critic: a DIFFERENT model than the Strategist. Download a small one on the Mac and put its
# exact id here (the id below is the Omen's; the Mac's MLX build will probably be named differently).
# A non-Qwen model (for example a Gemma or Mistral 7-9B) would match the Checkpoint 6.1 wording
# "different model family".
LLM_CRITIC_BASE_URL=http://localhost:1234/v1
LLM_CRITIC_MODEL=qwen2.5-7b-instruct
LLM_CRITIC_API_KEY=lm-studio

# Embeddings for RAG (Nov 17): nomic-embed-text in LM Studio. Empty = keyword search only.
LLM_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
# LLM_EMBED_BASE_URL defaults to LLM_BASE_URL
# Knowledge base folder (default kb_sources; KB_DIR=kb for the old placeholder notes)
